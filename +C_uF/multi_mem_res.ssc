component multi_mem_res
    nodes
        I = C_uF.C_uF;
    end
    inputs
        f = {0,'Hz'};
        inp = {-1,'1'};
    end
    outputs
        revOut = {-1,'1'};
    end
    annotations
        revOut : Side = right;
        I : Side = top;
        f : Side = top;
        inp : Side = top;
    end
    variables
        p = {0,'Pa'};
        q_dot = {0, 'mm^3/s^2'};
        q = {0,'mm^3/s'};
        h_liquid = {0,'mm'};
        p_cent = {0,'Pa'};
        f_dot = {0,'Hz/s'};
        p_Euler = {0,'Pa'};
        V_liquid = {0,'mm^3'};
        fill = {0,'1'};
        p_cap = {0,'Pa'};
        V_change_1 = {0,'mm^3'};
        V_change_2 = {0,'mm^3'};
        V_change_3 = {0,'mm^3'};
        p_mem_1 = {0,'Pa'};
        p_mem_2 = {0,'Pa'};
        p_mem_3 = {0,'Pa'};
        p_visc = {0,'Pa'};
        p_IRRF = {0,'Pa'};
        V_real = {0,'mm^3'};
        p_mem_t = {0,'Pa'};
    end
    parameters
        G = {0,'1'}; %Azimuthal position of the outlet
        init_vol = {0,'mm^3'}; %Initial fill
        d = {0,'mm'}; %Depth
        anglength = {0,'1'}; %Angle of aperture
        InRad = {10,'mm'}; %Inner Radius
        OutRad = {20,'mm'}; %Outer Radius
        mem_rad_1 = {8,'mm'}; %Radius of membrane 1
        mem_rad_2 = {8,'mm'}; %Radius of membrane 2
        mem_rad_3 = {8,'mm'}; %Radius of membrane 3
        mem_thick_1 = {50,'um'}; %Membrane 1 thickness
        mem_thick_2 = {50,'um'}; %Membrane 2 thickness
        mem_thick_3 = {50,'um'}; %Membrane 3 thickness
        init_stress_1 = {620000,'Pa'}; %Initial stress of membrane 1
        init_stress_2 = {620000,'Pa'}; %Initial stress of membrane 2
        init_stress_3 = {620000,'Pa'}; %Initial stress of membrane 3
        Young_1 = {2000000,'Pa'}; %Young's Modulus of membrane 1
        Young_2 = {2000000,'Pa'}; %Young's Modulus of membrane 1
        Young_3 = {2000000,'Pa'}; %Young's Modulus of membrane 1
        Poisson_1 = {0.5,'1'}; %Poisson's ratio of membrane 1
        Poisson_2 = {0.5,'1'}; %Poisson's ratio of membrane 2
        Poisson_3 = {0.5,'1'}; %Poisson's ratio of membrane 3
        theta = {pi/2,'1'}; %Contact angle
    end
    parameters (Access = private)
        p0 = {101325,'Pa'};
        Bi_modulus_1 = {0,'Pa'}; %Biaxial modulus of membrane 1
        Bi_modulus_2 = {0,'Pa'}; %Biaxial modulus of membrane 2
        Bi_modulus_3 = {0,'Pa'}; %Biaxial modulus of membrane 3
        Euler_fill = {0.1,'1'};
        EP = {100,'1/s'};
        w = {0,'mm'}; %Width
        V_total = {0,'mm^3'};
        Area = {1,'mm^2'};
        p_vap = {2329.575349457,'Pa'};
        fluidic_res_liq = {0,'Pa*s/mm^3'};
        fluidic_res_air = {0,'Pa*s/mm^3'};
        gamma_lg = {0.07275,'Pa*m'};
        epsilon = {10^-9,'Hz'};
        C = {1,'Hz'};
    end
    function setup
        across(p,I.p);
        through(q,I.q);
        Bi_modulus_1 = Young_1/(1-Poisson_1);
        Bi_modulus_2 = Young_2/(1-Poisson_2);
        Bi_modulus_3 = Young_3/(1-Poisson_3);
        w = 2*pi*InRad*anglength/360;
        Area = anglength*(pi/360)*(OutRad^2-InRad^2);
        % fluidic_res_liq = 12*I.viscosity*(OutRad-InRad)/(w*d^3*(1-192/(pi^5)*d/w*(tanh(pi*w/2/d)+31/32*1.0369)-1));
        % fluidic_res_air = 12*I.viscosity_air*(OutRad-InRad)/(w*d^3*(1-192/(pi^5)*d/w*(tanh(pi*w/2/d)+31/32*1.0369)-1));
        fluidic_res_liq = 28.4*I.viscosity*(OutRad-InRad)/(w^2*d^2);
        fluidic_res_air = 28.4*I.viscosity_air*(OutRad-InRad)/(w^2*d^2);
        V_total = Area*d;
        if init_vol >= V_total
            fill = 1;
            V_liquid = V_total;
        elseif init_vol > 0
            fill = init_vol/V_total;
            V_liquid = init_vol;
        else
            fill = 0;
            V_liquid = 0;
        end
    end
    equations
        fill == V_liquid/V_total;
        p_IRRF == (OutRad-InRad)*q_dot*(fill*I.density+(1-fill)*I.density_gas)/(w*d);
        q.der == q_dot;
        f.der == f_dot;
        h_liquid == sqrt(abs(OutRad^2-V_liquid*360/d/anglength/pi));
        p_cent == 0.5*I.density*(OutRad^2-(h_liquid)^2)*(2*pi*f)^2 + 0.5*I.density_gas*((h_liquid)^2-InRad^2)*(2*pi*f)^2;
        p_mem_1 == 4*init_stress_1*mem_thick_1*(2*V_change_1/(pi*mem_rad_1^4)) + ((8*(1.015-0.247*Poisson_1))/3)*Bi_modulus_1*mem_thick_1*(8*V_change_1^3/(pi^3*mem_rad_1^10));
        p_mem_1 == p_mem_2;
        p_mem_2 == p_mem_3;

        V_change_1 + V_change_2 + V_change_3 == V_liquid;

        p_mem_2 == 4*init_stress_2*mem_thick_2*(2*V_change_2/(pi*mem_rad_2^4)) + ((8*(1.015-0.247*Poisson_2))/3)*Bi_modulus_2*mem_thick_2*(8*V_change_2^3/(pi^3*mem_rad_2^10));
        p_mem_3 == 4*init_stress_3*mem_thick_3*(2*V_change_3/(pi*mem_rad_3^4)) + ((8*(1.015-0.247*Poisson_3))/3)*Bi_modulus_3*mem_thick_3*(8*V_change_3^3/(pi^3*mem_rad_3^10));
        p_mem_1 == p_mem_2;
        p_mem_2 == p_mem_3;
        p_mem_t == p_mem_1 + p_mem_2 + p_mem_3;

        p_visc == (fill*fluidic_res_liq + (1-fill)*fluidic_res_air)*q;

        if V_liquid > 0
            if f_dot > 0
                if fill > Euler_fill
                    p_Euler.der == EP*(-(G-1)*0.5*(I.density*w*2*pi*OutRad)*f_dot-p_Euler);
                else
                    p_Euler.der == EP*(-(G-1)*0.5*(I.density*w*2*pi*OutRad)*f_dot*(fill/Euler_fill)-p_Euler);
                end
            else
                if fill > Euler_fill
                    p_Euler.der == EP*(-(G+1)*0.5*(I.density*w*2*pi*OutRad)*f_dot-p_Euler);
                else
                    p_Euler.der == EP*(-(G+1)*0.5*(I.density*w*2*pi*OutRad)*f_dot*(fill/Euler_fill)-p_Euler);
                end
            end
            p_cap == gamma_lg*(((2*cos(theta))/w)+((2*cos(theta))/d));
        else
            p_Euler.der == -EP*p_Euler;
            p_cap == 0;
        end

        if (inp>1) && (fill<1) && (q>0)
            % filling
            V_liquid.der == abs(q);
            revOut == -1;
        elseif (inp>1) && (fill>=1) && (q>0)
            % filled
            V_liquid.der == 0;
            revOut == -1;
        elseif (fill>0) && (q<0)
            % defilling
            V_liquid.der == -abs(q);
            revOut == 2;
        else
            % either emptied or initially empty
            V_liquid.der == 0;
            revOut == -1;
        end

        %p + p_Euler + p_cap - p_visc - p_IRRF == p_mem_1 + p_mem_2 + p_mem_3 + p_cent;
        %p + p_Euler + p_cap - p_visc - p_IRRF == p_mem_1 + p_cent;
        p + p_Euler - p_cent + p_cap - p_visc - p_IRRF == p_mem_t;

    end
end
